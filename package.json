{
  "name": "gigga-goat",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Gigga-Goat: a wobbly-physics goat sandbox brawler for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "ci": "npm run typecheck && npm run test && npm run test:chrome && npm run build",
    "test:chrome": "vitest run --project chrome"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "meshoptimizer": "1.1.1",
    "polygon-clipping": "0.15.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
